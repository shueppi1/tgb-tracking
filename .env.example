# Copy to .env and adjust. Never commit .env.

# Random secret used to sign login tokens. Generate e.g. with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Team password. Preferred: a hash (generate with `python -m app.hash_password`
# inside backend/, or `docker compose run --rm api python -m app.hash_password`).
APP_PASSWORD_HASH=
# Alternative for quick setups: the plain password (hashed at startup).
APP_PASSWORD=

# Login validity in seconds (default 30 days).
TOKEN_MAX_AGE=2592000

# Interface the web UI is published on.
#   127.0.0.1 = only reachable on this host — correct when a reverse proxy such as
#               Caddy runs on the same machine and terminates TLS (see deploy/Caddyfile.example).
#   0.0.0.0   = reachable directly from the LAN over plain HTTP (no TLS).
WEB_BIND=127.0.0.1

# Host port the web UI is published on. Must match the reverse_proxy target in the Caddyfile.
# Not 8080 by default: that port is commonly taken already (Nextcloud AIO's admin UI, among
# others). Check before starting:  ss -ltnp | grep :8090
WEB_PORT=8090
