# Copy to .env and adjust. Never commit .env.

# Random secret used to sign login tokens. Generate e.g. with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Team password. Preferred: a hash (generate with `python -m app.hash_password`
# inside backend/, or `docker compose run --rm api python -m app.hash_password`).
APP_PASSWORD_HASH=
# Alternative for quick setups: the plain password (hashed at startup).
APP_PASSWORD=

# Login validity in seconds (default 30 days).
TOKEN_MAX_AGE=2592000

# Host port the web UI is published on.
WEB_PORT=8080
